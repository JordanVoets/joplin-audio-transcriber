{
  "name": "joplin-plugin-audio-transcriber",
  "version": "1.0.0",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
    "lint": "eslint --fix && prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "repository": "https://github.com/JordanVoets/joplin-audio-transcriber",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.7.13",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^10.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "prettier": "3.8.1",
    "tar": "^6.1.11",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "typescript-eslint": "^8.56.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
